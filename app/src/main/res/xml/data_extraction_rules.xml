<?xml version="1.0" encoding="utf-8"?>
<!-- Kunci penandatanganan clone tidak boleh ikut cadangan cloud/transfer perangkat;
     gunakan fitur Cadangkan kunci (terenkripsi kata sandi) di Pengaturan. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
